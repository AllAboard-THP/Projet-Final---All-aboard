#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v ruby >/dev/null 2>&1; then
  exec ruby "${SCRIPT_DIR}/rubocop.rb" "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: ruby is not installed and docker is unavailable." >&2
  exit 127
fi

CONTAINERS="$(docker ps --format '{{.Names}}' | awk '/website-railsfullstack-/')"

if [[ -z "${CONTAINERS}" ]]; then
  echo "Error: ruby is not installed and no running Rails container was found." >&2
  exit 127
fi

LAST_ERROR=""
for CONTAINER_NAME in ${CONTAINERS}; do
  if docker exec "${CONTAINER_NAME}" sh -lc 'cd /rails && bin/rubocop "$@"' sh "$@"; then
    exit 0
  fi
  LAST_ERROR="Failed to run RuboCop in container: ${CONTAINER_NAME}"
done

echo "${LAST_ERROR}" >&2
exit 1
